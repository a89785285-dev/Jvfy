# Server-only AI provider configuration.
# Never prefix secrets with EXPO_PUBLIC_ and never put them in app.config.ts.
AI_API_BASE_URL=https://api.openai.com
AI_API_KEY=replace_with_provider_key
AI_MODEL=gpt-4o-mini

# Optional: set only if you intentionally configure Manus OAuth.
# MANUS_PROJECT_ID=
# MANUS_JWT_SECRET=
# MANUS_OAUTH_API_URL=
